clear; clc; close all;

% =========================================================================
% 1. LOAD DATA
% =========================================================================
% Replace these filenames with the specific trial you are analyzing
forceplate_filename = 'quietEO.txt'; 
emg_filename = 'quieteo.data'; 

% Load Force Plate data (Assuming 6 columns: Fx, Fy, Fz, Mx, My, Mz) 
fp_data = load(forceplate_filename); 
Fx = fp_data(:, 1);
Fy = fp_data(:, 2);
Fz = fp_data(:, 3);
Mx = fp_data(:, 4);
My = fp_data(:, 5);
Mz = fp_data(:, 6);

% Load EMG data (Assuming 2 columns: SOL and TA) [cite: 113]
% *Adjust the column indices if your .data file is formatted differently*
emg_data = load(emg_filename); 
SOL_raw = emg_data(:, 1); 
TA_raw = emg_data(:, 2);

% =========================================================================
% 2. CALCULATE AP FROM FORCE PLATE DATA
% =========================================================================
dz = 41.3; % force plate thickness in mm [cite: 133]

% Calculate Anterior-Posterior (AP) COP. 
% We use the Y-equation from the manual as it aligns with the AP axis[cite: 135].
AP_raw = (Mx - Fy .* dz) ./ Fz; 

% =========================================================================
% 3. INTERPOLATION (200 Hz to 960 Hz) [cite: 143]
% =========================================================================
% Create time vector for original force plate data (sampled at 200 Hz)
t_fp = (0:length(AP_raw)-1) / 200;

% Create time vector for the new interpolated data (960 Hz)
t_interp = 0:(1/960):t_fp(end);

% Interpolate AP to 960 Hz [cite: 144]
AP_interp = interp1(t_fp, AP_raw, t_interp, 'linear');

% Match array lengths (Since synchronization is skipped, we align from t=0)
min_length = min(length(AP_interp), length(SOL_raw));
AP_interp = AP_interp(1:min_length)';
SOL_raw = SOL_raw(1:min_length);
TA_raw = TA_raw(1:min_length);

% =========================================================================
% 4. FILTERING [cite: 215, 236]
% =========================================================================
% 4th order, 5 Hz cutoff, 960 Hz sampling rate (Nyquist = 480) [cite: 217]
[b, a] = butter(4, 5/480, 'low'); 

% Filter COP (AP) and subtract the mean (DC component) [cite: 216, 218]
AP_filt = filtfilt(b, a, AP_interp); 
AP_filt = AP_filt - mean(AP_filt); 

% Rectify raw EMG data [cite: 236]
SOL_rect = abs(SOL_raw);
TA_rect = abs(TA_raw);

% Filter rectified EMG (Do NOT subtract the mean for EMG) [cite: 236, 237]
SOL_filt = filtfilt(b, a, SOL_rect);
TA_filt = filtfilt(b, a, TA_rect);

figure;plot(SOL_filt) %[output:38a05162]
figure;plot(TA_filt) %[output:99059c55]
figure;plot(AP_filt) %[output:2187c646]

% =========================================================================
% 5. CCF CALCULATION (DISCARDING FIRST 20 SECONDS)
% =========================================================================
freq = 960; 
seg_length = 8192; % 2^13 points [cite: 242]
offset = 20 * freq; % 19,200 samples to skip the first 20 seconds

% Pre-allocate matrices to store the 13 segment CCFs [cite: 242, 262]
ccf_seg_SOL = zeros(13, 2*seg_length - 1);
ccf_seg_TA = zeros(13, 2*seg_length - 1);

% Loop through the 13 segments [cite: 258]
for k = 1:13 %[output:group:4c6b047e]
    % Define the start and end indices for the segment, applying the 20s offset
    a_idx = (k-1)*(seg_length) + offset + 1;
    b_idx = (seg_length + offset) + (k-1)*(seg_length);
    
    % Safety check: ensure we don't exceed array dimensions
    if b_idx > length(AP_filt)
        warning('Data array is too short to extract all 13 segments after skipping 20 seconds.'); %[output:091bf309]
        break;
    end
    
    % Extract the segments and subtract the mean of the specific segment [cite: 261]
    AP_seg = AP_filt(a_idx:b_idx) - mean(AP_filt(a_idx:b_idx));
    SOL_seg = SOL_filt(a_idx:b_idx) - mean(SOL_filt(a_idx:b_idx));
    TA_seg = TA_filt(a_idx:b_idx) - mean(TA_filt(a_idx:b_idx));
    
    % Calculate CCF for the segment using 'coeff' (normalizes between -1 and 1) [cite: 247, 261]
    ccf_seg_SOL(k,:) = xcorr(SOL_seg, AP_seg, 'coeff');
    ccf_seg_TA(k,:) = xcorr(TA_seg, AP_seg, 'coeff');
end %[output:group:4c6b047e]

% Calculate the ensemble-averaged CCF [cite: 264]
% (We use 1:k just in case the loop broke early due to data length)
avg_ccf_SOL = mean(ccf_seg_SOL(1:k,:), 1);
avg_ccf_TA = mean(ccf_seg_TA(1:k,:), 1);

% Create the time shift array for plotting [cite: 265]
time_shift = (-(seg_length-1):1:(seg_length-1)) / freq;

% =========================================================================
% 6. EXTRACT CVAL / TS AND PLOT RESULTS [cite: 245, 282, 283]
% =========================================================================
% Find max CCF value (CVAL) and corresponding time shift (TS) for Soleus
[CVAL_SOL, max_idx_SOL] = max(avg_ccf_SOL);
TS_SOL = time_shift(max_idx_SOL);

% Find max CCF value (CVAL) and corresponding time shift (TS) for Tibialis Anterior
[CVAL_TA, max_idx_TA] = max(avg_ccf_TA);
TS_TA = time_shift(max_idx_TA);

% Plotting
figure('Name', 'Cross-Correlation Functions', 'Position', [100, 100, 800, 600]); %[output:03e8d18c]

% Subplot 1: AP vs SOL
subplot(2,1,1); %[output:03e8d18c]
plot(time_shift, avg_ccf_SOL, 'b', 'LineWidth', 1.5); hold on; %[output:03e8d18c]
plot(TS_SOL, CVAL_SOL, 'r*', 'MarkerSize', 10); %[output:03e8d18c]
title(sprintf('Average CCF: AP vs SOL (CVAL = %.3f, TS = %.3f s)', CVAL_SOL, TS_SOL)); %[output:03e8d18c]
xlabel('Time Shift (s)'); ylabel('Cross-Correlation'); grid on; %[output:03e8d18c]

% Subplot 2: AP vs TA
subplot(2,1,2); %[output:03e8d18c]
plot(time_shift, avg_ccf_TA, 'Color', [0 0.5 0], 'LineWidth', 1.5); hold on; %[output:03e8d18c]
plot(TS_TA, CVAL_TA, 'r*', 'MarkerSize', 10); %[output:03e8d18c]
title(sprintf('Average CCF: AP vs TA (CVAL = %.3f, TS = %.3f s)', CVAL_TA, TS_TA)); %[output:03e8d18c]
xlabel('Time Shift (s)'); ylabel('Cross-Correlation'); grid on; %[output:03e8d18c]

% Note: A negative TS means the EMG signal precedes the COP displacement[cite: 249].

